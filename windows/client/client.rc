#include <windows.h>

1 ICON "app.ico"
1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041904B0"
    BEGIN
      VALUE "CompanyName", "MagerCam"
      VALUE "FileDescription", "MagerCam - phone as a webcam"
      VALUE "FileVersion", "1.0.0"
      VALUE "ProductName", "MagerCam"
      VALUE "ProductVersion", "1.0.0"
      VALUE "OriginalFilename", "MagerCam.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x419, 1200
  END
END
